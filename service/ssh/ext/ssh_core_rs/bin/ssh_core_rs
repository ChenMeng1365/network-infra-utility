#!/usr/bin/env bash
# ssh_core_rs engine launcher for Linux/macOS
# Starts the Rust SSH core engine in foreground mode.
# Called by Ruby Client.spawn_engine via Process.spawn.
#
# This is the Rust-based replacement for the Erlang ssh_core engine.
# It implements the exact same IPC protocol, so Ruby can switch between
# the two backends by changing the engine_binary_path in client.rb.

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SRC_DIR="$(dirname "$SCRIPT_DIR")"

# Delete stale endpoint file so Ruby can detect fresh startup
ENDPOINT_FILE="/tmp/ssh_core_$(id -u).endpoint"
rm -f "$ENDPOINT_FILE"

# Check if pre-built binary exists
BINARY="$SRC_DIR/target/release/ssh_core_rs"
if [ -f "$BINARY" ]; then
    exec "$BINARY"
fi

# Build if not yet compiled
echo "Building ssh_core_rs (release)..." >&2
if ! command -v cargo &> /dev/null; then
    echo "Error: cargo not found in PATH. Please install Rust toolchain." >&2
    exit 1
fi
cargo build --release --manifest-path "$SRC_DIR/Cargo.toml"

# Run the engine in foreground (blocks until shutdown)
exec "$BINARY"
