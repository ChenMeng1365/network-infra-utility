%% Erlang/OTP 26+ required (ssh, public_key, crypto, kernel, stdlib)
{erl_opts, [
    debug_info,
    {src_dirs, ["src", "local_deps/jsx/src/src"]},
    {platform_define, "win32", win32}
]}.

{deps, []}.

{shell, [
    {apps, [ssh_core]}
]}.

{relx, [
    {release, {ssh_core, "1.0.0"}, [ssh_core, runtime_tools, sasl]},
    {mode, dev},
    {include_erts, true},
    {include_src, false},
    {overlay, [
        {mkdir, "{{output_dir}}/logs"},
        {copy, "config/vm.args", "{{output_dir}}/releases/1.0.0/vm.args"},
        {copy, "config/sys.config", "{{output_dir}}/releases/1.0.0/sys.config"}
    ]}
]}.
