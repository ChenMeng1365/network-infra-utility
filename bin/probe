#!/usr/bin/env ruby
# frozen_string_literal: true
# coding: utf-8
#
# probe — 网络服务连通性探测命令行工具 (network-infra-utility)
#
# 用法:
#   probe <host> [协议...] [选项]
#   probe 10.0.0.1 ssh snmp dns          # 探测指定协议
#   probe 10.0.0.1 --all                 # 探测全部协议
#   probe 10.0.0.1 ssh --timeout 5       # 自定义超时
#   probe 10.0.0.1 snmp --community RO   # SNMP 团体名
#   probe 10.0.0.1 --all --json          # JSON 输出
#
# 选项:
#   -p, --port PORT        覆盖默认端口
#   -t, --timeout SEC      超时(秒), 默认 3
#       --all              探测全部协议
#       --json             JSON 输出
#       --community NAME   SNMP 团体名 (默认 public)
#       --list             列出全部可用协议
#   -v, --version          显示版本
#   -h, --help             显示帮助
#
# 退出码: 0 全部可达, 1 存在失败, 2 参数错误

require "optparse"
require "json"

begin
  require "probe"
rescue LoadError
  $LOAD_PATH.unshift(File.expand_path("../tool/probe/lib", __dir__))
  require "probe"
end

require_relative "../version"

module ProbeCLI
  module_function

  def run(argv)
    options = { timeout: 3, all: false, json: false, port: nil, community: "public", list: false }
    parser = build_parser(options)

    begin
      parser.parse!(argv)
    rescue OptionParser::ParseError => e
      warn "错误: #{e.message}"
      return 2
    end

    return print_help(parser) if options[:help]
    return print_version if options[:version]
    return print_protocols if options[:list]

    if argv.empty?
      warn "错误: 缺少目标主机"
      warn "用法: probe <host> [协议...] [选项]  (用 -h 查看完整帮助)"
      return 2
    end

    host = argv.shift
    protocols = options[:all] ? nil : argv.map(&:to_sym)
    return 2 if protocols && protocols.empty?

    run_probes(host, protocols, options)
  end

  def run_probes(host, protocols, options)
    opts = { timeout: options[:timeout].to_f }
    opts[:port] = options[:port].to_i if options[:port]
    opts[:community] = options[:community] if options[:community]

    results = NetworkInfraUtility::Probe.check(host, protocols: protocols, **opts)

    if options[:json]
      puts JSON.pretty_generate(results.map(&:to_h))
    else
      results.each { |r| puts r.to_s }
      failed = results.reject(&:ok?)
      puts ""
      puts "结果: #{results.size - failed.size}/#{results.size} 可达"
    end

    results.any? { |r| !r.ok? } ? 1 : 0
  rescue ArgumentError => e
    warn "错误: #{e.message}"
    2
  end

  def build_parser(options)
    OptionParser.new do |opts|
      opts.banner = <<~BAN
        probe — 网络服务连通性探测工具

        用法:
          probe <host> [协议...] [选项]
          probe 10.0.0.1 ssh snmp dns
          probe 10.0.0.1 --all
          probe 10.0.0.1 --all --json

        可用协议: #{NetworkInfraUtility::Probe.protocols.join(', ')}

        选项:
      BAN
      opts.on("-p", "--port PORT", Integer, "覆盖默认端口") { |v| options[:port] = v }
      opts.on("-t", "--timeout SEC", Float, "超时(秒), 默认 3") { |v| options[:timeout] = v }
      opts.on("--all", "探测全部协议") { options[:all] = true }
      opts.on("--json", "JSON 输出") { options[:json] = true }
      opts.on("--community NAME", "SNMP 团体名 (默认 public)") { |v| options[:community] = v }
      opts.on("--list", "列出全部可用协议") { options[:list] = true }
      opts.on("-v", "--version", "显示版本") { options[:version] = true }
      opts.on("-h", "--help", "显示帮助") { options[:help] = true }
    end
  end

  def print_help(parser)
    puts parser
    0
  end

  def print_version
    puts "probe #{NetworkInfraUtility::VERSION}"
    0
  end

  def print_protocols
    puts NetworkInfraUtility::Probe.protocols.join(" ")
    0
  end
end

exit ProbeCLI.run(ARGV) if File.basename($PROGRAM_NAME) == File.basename(__FILE__)
