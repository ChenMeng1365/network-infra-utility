#!/usr/bin/env ruby
# frozen_string_literal: true
# coding: utf-8
#
# geo-api — network-infra-utility 的 IP 归属信息查询命令行服务
#
# 把 service/geodb 的 GeoAPI 封装为可直接调用的命令行服务，默认监听
# 0.0.0.0:9292，供本地或同网段主机通过 HTTP 查询 IP 归属信息
# (asn / city / country 三个接口，详见 service/geodb/GeoAPI.md)。
#
# 用法:
#   geo-api                              # 默认 ./geodb/ + 0.0.0.0:9292
#   geo-api -d /data/ipdb                # 指定数据文件目录
#   geo-api -d /data/ipdb -a ./GEO_CACHE # 外带 GEO_CACHE 缓存目录
#   geo-api --priority local,cache       # 关闭互联网兑底 (离线环境)
#   geo-api -p 8080                      # 指定端口
#   geo-api -b 127.0.0.1 -p 9292 -d ./ipdb
#   geo-api --server puma                # 指定 Rack 服务器
#   GEODB_DATA_DIR=/data/ipdb geo-api    # 通过环境变量指定数据目录
#
# 选项:
#   -d, --data-dir DIR     IP 数据文件目录，默认 ./geodb/
#   -a, --cache-dir DIR    GEO_CACHE 外带缓存目录 (geocacheYYYYMMDD.json,
#                          ngeo-get -c 产出; addr 查询兑底)
#   --priority ORDER       查询顺位 local,cache,online 的排列
#                          (默认 local,cache,online: 本地 → 缓存 → 互联网)
#   --online-timeout SEC   互联网兑底 HTTP 超时秒数, 默认 8
#                          (百度智能IP定位 → ip-api.com, 逐接口限速+熔断)
#   -b, --host HOST        监听地址，默认 0.0.0.0
#   -p, --port PORT        监听端口，默认 9292
#   -s, --server NAME      Rack 服务器，默认 puma
#   -h, --help             显示帮助
#   -v, --version          显示版本
#
# 数据目录说明:
#   目录下应至少存在 geoapi 期望的 JSON 文件之一 (asn.json / city-IPv4.json /
#   country-IPv4.json / country-IPv6.json / city-IPv6.json / geo-city.json /
#   geo-country.json)。目录不存在或没有任何 *.json 文件将直接报错退出。
#   查询时若具体文件缺失，对应接口容错返回 404 无结果，不影响其他接口。
#
# 缓存目录说明:
#   -a 指定的 GEO_CACHE 目录内存放 geocacheYYYYMMDD.json (客户端 ngeo-get
#   查询产出)。addr 查询按 --priority 顺位 (默认 local,cache,online) 编排:
#   先查本地 GeoLite2 库，再缓存兑底，最后互联网兜底 (百度智能IP定位 →
#   ip-api.com)。目录不存在仅警告不退出 (首次使用可能尚无产出文件，
#   后续创建自动感知); 目录内文件增删改自动感知，无需重启。
#   缓存命中响应附 "cached": true 标记。
#
# 互联网兑底说明:
#   顺位含 online 时，本地库与 GEO_CACHE 均无结果的 addr 查询自动走
#   互联网 (百度智能IP定位 → ip-api.com 链式，百度查不出来才用 ip-api)，
#   响应附 "online": true 标记。逐接口限速 (百度 1 QPS / ip-api 45 req/min)
#   与熔断 (连续 3 次不可达暂停 60s) 内置，多线程安全不阻塞;
#   离线环境用 --priority local,cache 关闭。

require "optparse"
require "rackup"

# 找到 gem 自身根目录 (本文件在 <root>/bin/geo-api)
ROOT = File.expand_path("..", __dir__)
$LOAD_PATH.unshift File.join(ROOT, "service", "geodb")

# 命令行默认值
options = {
  data_dir: nil,
  cache_dir: nil,
  priority: nil,
  online_timeout: nil,
  host: "0.0.0.0",
  port: 9292,
  server: "puma"
}

parser = OptionParser.new do |opts|
  opts.banner = <<~BAN
    geo-api — IP 归属信息查询服务 (network-infra-utility)

    用法:
      geo-api [options]
      GEODB_DATA_DIR=/data/ipdb geo-api

    选项:
  BAN
  opts.on("-d", "--data-dir DIR", "IP 数据文件目录，默认 ./geodb/") { |v| options[:data_dir] = v }
  opts.on("-a", "--cache-dir DIR", "GEO_CACHE 外带缓存目录 (geocache*.json, 查询兑底)") { |v| options[:cache_dir] = v }
  opts.on("--priority ORDER", "查询顺位 local,cache,online 排列 (默认 local,cache,online)") { |v| options[:priority] = v }
  opts.on("--online-timeout SEC", Integer, "互联网兑底 HTTP 超时秒数 (默认 8)") { |v| options[:online_timeout] = v }
  opts.on("-b", "--host HOST", "监听地址，默认 0.0.0.0") { |v| options[:host] = v }
  opts.on("-p", "--port PORT", Integer, "监听端口，默认 9292") { |v| options[:port] = v }
  opts.on("-s", "--server NAME", "Rack 服务器，默认 puma") { |v| options[:server] = v }
  opts.on("-v", "--version", "显示版本") do
    require_relative "../version"
    puts "geo-api #{NetworkInfraUtility::VERSION}"
    exit 0
  end
  opts.on("-h", "--help", "显示帮助") do
    puts opts
    exit 0
  end
end
parser.parse!

# 数据目录: 命令行 > 环境变量 > 默认 ./geodb
data_dir = options[:data_dir] || ENV["GEODB_DATA_DIR"] || "geodb"
data_dir = File.expand_path(data_dir)
ENV["GEODB_DATA_DIR"] = data_dir

# ---- 启动前校验数据目录 ---------------------------------------------------
# 目录不存在直接报错退出；目录存在但没有任何 *.json 也视为错误。
unless File.directory?(data_dir)
  warn "✗ 数据目录不存在: #{data_dir}"
  warn "  请用 -d/--data-dir 指定正确的数据文件目录，或在该位置创建 geodb/ 目录。"
  warn "  期望目录结构: #{data_dir}/ 下含 asn.json / city-IPv4.json /"
  warn "                country-IPv4.json / geo-city.json 等 JSON 数据文件。"
  exit 1
end

json_files = Dir.glob(File.join(data_dir, "*.json"))
if json_files.empty?
  warn "✗ 数据目录 #{data_dir} 下没有任何 JSON 数据文件。"
  warn "  请先将 GeoLite2 CSV 数据通过 service/geodb/geodb.rb 生成为 JSON，"
  warn "  或用 -d/--data-dir 指向已生成 JSON 的目录。"
  exit 1
end

# ---- 顺位与互联网兑底 -------------------------------------------------------
cache_order = options[:priority] || "local,cache,online"
parts = cache_order.split(/[,\s]+/).map(&:strip).reject(&:empty?)
unless !parts.empty? && parts.all? { |p| %w[local cache online].include?(p) } && parts.uniq.size == parts.size
  warn "✗ 无效顺位: #{cache_order} (geo-api 仅支持 local / cache / online 的排列)"
  warn "  示例: --priority local,cache,online   (默认, 本地 → 缓存 → 互联网)"
  warn "        --priority local,cache       (离线环境, 关闭互联网兑底)"
  exit 1
end
ENV["GEODB_CACHE_ORDER"] = parts.join(",")

ENV["GEODB_ONLINE_TIMEOUT"] = options[:online_timeout].to_s if options[:online_timeout]

cache_dir = nil
if options[:cache_dir]
  cache_dir = File.expand_path(options[:cache_dir])
  # 目录不存在仅警告: 首次使用可能尚无产出文件, 后续创建自动感知
  unless File.directory?(cache_dir)
    warn "⚠ 缓存目录不存在: #{cache_dir} (将继续启动, 目录创建后自动感知)"
  end
  ENV["GEODB_CACHE_DIR"] = cache_dir
end

require_relative "../version"
puts "╭─ geo-api #{NetworkInfraUtility::VERSION} ─────────────────────────────"
puts "│ 数据目录: #{data_dir} "
puts "│ #{json_files.length}个数据文件：#{json_files.map { |f| File.basename(f) }.join(' ')}"
if cache_dir
  n_cache = Dir.glob(File.join(cache_dir, "geocache*.json")).select { |f| /\Ageocache\d{8}\.json\z/ =~ File.basename(f) }.size
  puts "│ 缓存目录: #{cache_dir} (#{n_cache}个缓存文件)"
end
puts "│ 查询顺位: #{parts.join(',')}"
if parts.include?("online")
  puts "│ 互联网兑底: 百度智能IP定位 → ip-api.com (限速+熔断, 超时 #{ENV['GEODB_ONLINE_TIMEOUT'] || 8}s)"
end
puts "│ 监听: http://#{options[:host]}:#{options[:port]}"
puts "│ 服务: #{options[:server]}"
puts "╰─ Ctrl+C 退出 ─────────────────────────────────────"
$stdout.flush

# ---- 启动服务 -------------------------------------------------------------
require "api"   # 即 service/geodb/api.rb

Rackup::Server.start(
  app:    GeoAPI.app,
  server: options[:server],
  Host:   options[:host],
  Port:   options[:port]
)
