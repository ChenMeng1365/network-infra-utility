#!/usr/bin/env ruby
# frozen_string_literal: true
# coding: utf-8
#
# dns-query — 跨平台统一域名查询命令行工具 (network-infra-utility)
#
# 自动检测当前平台所有可用的 DNS 查询工具 (dig / nslookup / host /
# Resolve-DnsName 等)，默认使用优先级最高的工具执行查询；也支持指定
# DNS 服务器、指定记录类型、遍历全部可用工具交叉查询。
#
# 用法:
#   ruby bin/dns-query <目标> [选项]
#   ruby bin/dns-query www.baidu.com              # 正查 A 记录
#   ruby bin/dns-query 8.8.8.8                     # 反查 PTR (自动识别 IP)
#   ruby bin/dns-query www.baidu.com -t MX         # 指定记录类型
#   ruby bin/dns-query www.baidu.com -s 8.8.8.8    # 指定 DNS 服务器
#   ruby bin/dns-query www.baidu.com -a            # 用所有可用工具查询
#   ruby bin/dns-query --tools                     # 列出当前平台可用工具
#   ruby bin/dns-query --matrix                    # 全平台工具矩阵
#
# 选项:
#   -t, --type TYPE      DNS 记录类型, 默认 A
#   -s, --server SERVER  指定 DNS 服务器 (IP 或域名)
#   -a, --all            使用所有可用工具交叉查询
#       --tools          列出当前平台可用工具
#       --matrix         显示全平台工具矩阵
#       --no-color       禁用 ANSI 颜色输出
#   -v, --version        显示版本
#   -h, --help           显示帮助
#
# 退出码: 0 成功, 1 参数错误 / 无可用工具 / 查询全部失败

require "optparse"
require "rbconfig"
require "shellwords"
require "ipaddr"
require_relative "../version"

module DnsQuery
  # ============================================================
  # 平台检测
  # ============================================================
  module Platform
    def self.os
      @os ||= detect_os
    end

    def self.linux?
      os == :linux
    end

    def self.windows?
      os == :windows
    end

    def self.wsl?
      linux? && File.exist?("/proc/version") &&
        File.read("/proc/version").downcase.include?("microsoft")
    end

    def self.distro
      @distro ||= detect_distro
    end

    def self.windows_build
      return @win_build if @win_build
      return nil unless windows?
      raw = cmd_utf8("ver 2>NUL").strip
      if raw =~ /(\d+\.\d+\.(\d+))/
        @win_build = Regexp.last_match(2).to_i
      else
        @win_build = 0
      end
      @win_build
    end

    def self.windows_version_name
      return nil unless windows?
      b = windows_build
      if b >= 22000 then "Win11"
      elsif b >= 10240 then "Win10"
      else "Win7"
      end
    end

    def self.ps_version
      return @ps_ver if @ps_ver
      if windows?
        raw = cmd_utf8('powershell -Command "$PSVersionTable.PSVersion.Major" 2>NUL').strip
        @ps_ver = raw.to_i
      else
        @ps_ver = 0
      end
      @ps_ver
    end

    def self.to_s
      if linux?
        wsl_suffix = wsl? ? " (WSL)" : ""
        "Linux/#{distro}#{wsl_suffix}"
      elsif windows?
        "Windows/#{windows_version_name}"
      else
        "Unknown"
      end
    end

    private

    # Windows 命令输出常为 GBK 编码，统一转成 UTF-8 字符串再处理
    def self.cmd_utf8(cmd)
      out = `#{cmd}`
      if out.encoding == Encoding::UTF_8 && !out.valid_encoding?
        out = out.force_encoding(Encoding::GBK)
      end
      out.encode(Encoding::UTF_8, invalid: :replace, undef: :replace)
    rescue StandardError
      out
    end

    def self.detect_os
      case RbConfig::CONFIG["host_os"]
      when /linux/   then :linux
      when /mswin|mingw|cygwin|windows/ then :windows
      when /darwin/  then :darwin
      else :unknown
      end
    end

    def self.detect_distro
      return :unknown unless linux?
      if File.exist?("/etc/alpine-release")      then :alpine
      elsif File.exist?("/etc/lsb-release")       then :ubuntu
      elsif File.exist?("/etc/debian_version")    then :debian
      elsif File.exist?("/etc/redhat-release")     then :rhel
      else :unknown_linux
      end
    end
  end

  # ============================================================
